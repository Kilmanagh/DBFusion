<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DBFusion.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="DBFusion.GUI.MainWindow"
        Title="DBFusion GUI - Universal Database Client">

    <Design.DataContext>
        <!-- This enables design-time data context and IntelliSense for bindings -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel Margin="5">
        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="5">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>

        <!-- Connection and DB Selection Panel -->
        <Border DockPanel.Dock="Top" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="Database Configuration" FontWeight="Bold" FontSize="14"/>
                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Gap="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Database Type:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DatabaseTypes}" SelectedItem="{Binding SelectedDatabaseType}" HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Connection String:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ConnectionString}" Watermark="Enter full connection string (or use fields below for components)" HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Username:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Username}" Watermark="Database username" HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Password:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Password}" PasswordChar="*" Watermark="Database password" HorizontalAlignment="Stretch"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Classes="accent"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Content Area (Query, Results, Actions) -->
        <Grid ColumnDefinitions="3*, 7*" RowDefinitions="Auto,*" Margin="0,10,0,0" Gap="10">

            <!-- Query Input and Action Buttons -->
            <DockPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
                <TextBlock DockPanel.Dock="Top" Text="Query & Actions" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <TextBox DockPanel.Dock="Top" Text="{Binding QueryText}" AcceptsReturn="True" Watermark="Enter your query here..." Height="200" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Vertical" Spacing="8" Margin="0,10,0,0">
                    <TextBlock Text="CRUD Operations:" FontWeight="SemiBold"/>
                    <Button Content="SELECT" Command="{Binding SelectCommand}"/>
                    <Button Content="INSERT" Command="{Binding InsertCommand}"/>
                    <Button Content="UPDATE" Command="{Binding UpdateCommand}"/>
                    <Button Content="DELETE" Command="{Binding DeleteCommand}"/>
                    <Button Content="Execute Generic Command" Command="{Binding ExecuteCommand}" Margin="0,8,0,0"/>

                    <TextBlock Text="Transaction Management:" FontWeight="SemiBold" Margin="0,15,0,0"/>
                    <Button Content="Begin Transaction" Command="{Binding BeginTransactionCommand}"/>
                    <Button Content="Commit Transaction" Command="{Binding CommitTransactionCommand}"/>
                    <Button Content="Rollback Transaction" Command="{Binding RollbackTransactionCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- Results Area -->
            <DockPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                <TextBlock DockPanel.Dock="Top" Text="Results / Output" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                <TabControl>
                    <TabItem Header="Data Grid">
                        <DataGrid Name="ResultsDataGrid" ItemsSource="{Binding DataGridResults}" IsReadOnly="True" CanUserSortColumns="True" AutoGenerateColumns="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </TabItem>
                    <TabItem Header="Text Output">
                        <TextBox Name="ResultsTextBox" Text="{Binding TextResults}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
